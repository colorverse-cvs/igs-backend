# Application Environment
NODE_ENV=development
PORT=3000

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Database
MONGO_URI=mongodb://admin:root@localhost:27017/giftshop?authSource=admin
MONGO_DB=giftshop

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=3600s

# Super Admin (for migrations)
SUPER_ADMIN_EMAIL=admin@ishitagallery.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Payments (Stripe)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=supersecretrazorpay

CORS_ORIGINS=http://localhost:4000

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=60000 
